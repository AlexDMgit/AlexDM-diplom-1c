
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда) 
	Если Не ЗначениеЗаполнено(ГрафикРабот) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не указан график работ.",,"ГрафикРабот");
		Возврат;
	Конецесли;
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Или Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не указан период заполнения графика работ.",,"Период");
		Возврат;
	Конецесли;			
	
	ВыходныеДни = "";
	Если ПН Тогда
		ВыходныеДни = ВыходныеДни + "1";
	КонецЕсли;
	Если ВТ Тогда
		ВыходныеДни = ВыходныеДни + "2";
	КонецЕсли;
	Если СР Тогда
		ВыходныеДни = ВыходныеДни + "3";
	КонецЕсли;
	Если ЧТ Тогда
		ВыходныеДни = ВыходныеДни + "4";
	КонецЕсли;
	Если ПТ Тогда
		ВыходныеДни = ВыходныеДни + "5";
	КонецЕсли;
	Если СБ Тогда
		ВыходныеДни = ВыходныеДни + "6";
	КонецЕсли;
	Если ВС Тогда
		ВыходныеДни = ВыходныеДни + "7";
	КонецЕсли;
	
	ЗаполнитьНаСервере(ВыходныеДни);
	ОбщегоНазначенияКлиент.СообщитьПользователю("График заполнен.");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере(ВыходныеДни)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.ЗаполнитьГрафик(Период.ДатаНачала, Период.ДатаОкончания, ВыходныеДни, ГрафикРабот);	

КонецПроцедуры

#КонецОбласти
